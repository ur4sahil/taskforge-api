generator client {
  provider = "prisma-client-js"
}

// Supabase setup: pooled connection for app, direct connection for migrations
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // Supabase pooler (port 6543)
  directUrl = env("DIRECT_URL")         // Supabase direct (port 5432)
}

// ═══ AUTH & USERS ═══

enum AuthProvider {
  email
  google
  microsoft
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(255)
  passwordHash String?      @map("password_hash") @db.VarChar(255)
  name         String       @db.VarChar(255)
  avatarUrl    String?      @map("avatar_url") @db.VarChar(500)
  authProvider AuthProvider @default(email) @map("auth_provider")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  workspaceMembers WorkspaceMember[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  userAgent String?  @map("user_agent") @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

// ═══ WORKSPACES ═══

enum WorkspaceRole {
  admin
  manager
  employee
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members         WorkspaceMember[]
  invitations     Invitation[]
  lists           List[]
  tasks           Task[]
  attachments     Attachment[]
  notifications   Notification[]
  templates       Template[]
  savedViews      SavedView[]
  auditLogs       AuditLog[]
  recurrenceRules RecurrenceRule[]

  @@map("workspaces")
}

model WorkspaceMember {
  id                      String        @id @default(uuid()) @db.Uuid
  workspaceId             String        @map("workspace_id") @db.Uuid
  userId                  String        @map("user_id") @db.Uuid
  role                    WorkspaceRole @default(employee)
  managerId               String?       @map("manager_id") @db.Uuid
  notificationPreferences Json          @default("{}") @map("notification_preferences")
  timezone                String        @default("UTC") @db.VarChar(50)
  invitedBy               String?       @map("invited_by") @db.Uuid
  isActive                Boolean       @default(true) @map("is_active")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager         WorkspaceMember?  @relation("ManagerRelation", fields: [managerId], references: [id])
  reports         WorkspaceMember[] @relation("ManagerRelation")
  createdTasks    Task[]            @relation("TaskCreator")
  assignedTasks   Task[]            @relation("TaskAssignee")
  lockedTasks     Task[]            @relation("TaskLocker")
  comments        Comment[]
  attachments     Attachment[]      @relation("AttachmentUploader")
  reminders       Reminder[]
  notifications   Notification[]
  deviceTokens    DeviceToken[]
  listMembers     ListMember[]
  createdLists    List[]            @relation("ListCreator")
  defaultForLists List[]            @relation("ListDefaultAssignee")
  addedToLists    ListMember[]      @relation("ListMemberAdder")
  createdTemplates Template[]
  createdViews    SavedView[]
  auditLogs       AuditLog[]        @relation("AuditActor")

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([managerId])
  @@map("workspace_members")
}

model Invitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  email       String        @db.VarChar(255)
  role        WorkspaceRole @default(employee)
  managerId   String?       @map("manager_id") @db.Uuid
  tokenHash   String        @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  invitedBy   String        @map("invited_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([workspaceId, email])
  @@map("invitations")
}

model DeviceToken {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceMemberId String   @map("workspace_member_id") @db.Uuid
  token             String   @db.VarChar(500)
  platform          String   @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")

  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([workspaceMemberId, token])
  @@map("device_tokens")
}

// ═══ LISTS ═══

model List {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  name                String    @db.VarChar(255)
  description         String?   @db.Text
  inboundEmail        String?   @unique @map("inbound_email") @db.VarChar(255)
  inboundEmailEnabled Boolean   @default(false) @map("inbound_email_enabled")
  defaultAssigneeId   String?   @map("default_assignee_id") @db.Uuid
  settings            Json      @default("{}")
  createdById         String    @map("created_by_id") @db.Uuid
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       WorkspaceMember  @relation("ListCreator", fields: [createdById], references: [id])
  defaultAssignee WorkspaceMember? @relation("ListDefaultAssignee", fields: [defaultAssigneeId], references: [id])
  members         ListMember[]
  tasks           Task[]

  @@index([workspaceId])
  @@map("lists")
}

model ListMember {
  id                String   @id @default(uuid()) @db.Uuid
  listId            String   @map("list_id") @db.Uuid
  workspaceMemberId String   @map("workspace_member_id") @db.Uuid
  addedById         String   @map("added_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  list            List            @relation(fields: [listId], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  addedBy         WorkspaceMember @relation("ListMemberAdder", fields: [addedById], references: [id])

  @@unique([listId, workspaceMemberId])
  @@map("list_members")
}

// ═══ TASKS ═══

enum TaskStatus {
  todo
  in_progress
  waiting_for
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskSource {
  manual
  email
  template
  recurring
  ai
}

model Task {
  id           String       @id @default(uuid()) @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  listId       String       @map("list_id") @db.Uuid
  parentTaskId String?      @map("parent_task_id") @db.Uuid
  title        String       @db.VarChar(255)
  description  String?      @db.Text
  status       TaskStatus   @default(todo)
  priority     TaskPriority @default(medium)
  creatorId    String       @map("creator_id") @db.Uuid
  assigneeId   String?      @map("assignee_id") @db.Uuid
  source       TaskSource   @default(manual)
  isLocked     Boolean      @default(false) @map("is_locked")
  lockedById   String?      @map("locked_by_id") @db.Uuid
  lockedAt     DateTime?    @map("locked_at")
  startDate    DateTime?    @map("start_date") @db.Date
  startTime    String?      @map("start_time") @db.VarChar(5)
  dueDate      DateTime?    @map("due_date") @db.Date
  dueTime      String?      @map("due_time") @db.VarChar(5)
  timezone     String?      @db.VarChar(50)
  completedAt  DateTime?    @map("completed_at")
  archivedAt   DateTime?    @map("archived_at")
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list           List             @relation(fields: [listId], references: [id], onDelete: Cascade)
  parentTask     Task?            @relation("SubtaskRelation", fields: [parentTaskId], references: [id])
  subtasks       Task[]           @relation("SubtaskRelation")
  creator        WorkspaceMember  @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee       WorkspaceMember? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  lockedBy       WorkspaceMember? @relation("TaskLocker", fields: [lockedById], references: [id])
  checklistItems ChecklistItem[]
  comments       Comment[]
  attachments    Attachment[]
  reminders      Reminder[]
  emailMetadata  TaskEmailMetadata?
  recurrenceRule RecurrenceRule?
  taskInstance   TaskInstance?

  @@index([workspaceId])
  @@index([listId])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([parentTaskId])
  @@index([status])
  @@index([deletedAt])
  @@map("tasks")
}

model TaskEmailMetadata {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @unique @map("task_id") @db.Uuid
  fromAddress String   @map("from_address") @db.VarChar(255)
  fromName    String?  @map("from_name") @db.VarChar(255)
  toAddress   String   @map("to_address") @db.VarChar(255)
  ccAddresses String[] @map("cc_addresses")
  subject     String   @db.VarChar(500)
  messageId   String?  @map("message_id") @db.VarChar(500)
  inReplyTo   String?  @map("in_reply_to") @db.VarChar(500)
  rawHeaders  Json?    @map("raw_headers")
  rawBodyText String?  @map("raw_body_text") @db.Text
  rawBodyHtml String?  @map("raw_body_html") @db.Text
  receivedAt  DateTime @map("received_at")
  createdAt   DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@map("task_email_metadata")
}

model ChecklistItem {
  id        String  @id @default(uuid()) @db.Uuid
  taskId    String  @map("task_id") @db.Uuid
  text      String  @db.VarChar(500)
  isChecked Boolean @default(false) @map("is_checked")
  sortOrder Int     @default(0) @map("sort_order")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId])
  @@map("checklist_items")
}

// ═══ COMMENTS (IMMUTABLE) ═══

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      WorkspaceMember @relation(fields: [authorId], references: [id])
  mentions    Mention[]
  attachments Attachment[]

  @@index([taskId])
  @@map("comments")
}

model Mention {
  id                String @id @default(uuid()) @db.Uuid
  commentId         String @map("comment_id") @db.Uuid
  mentionedMemberId String @map("mentioned_member_id") @db.Uuid

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  @@index([commentId])
  @@index([mentionedMemberId])
  @@map("mentions")
}

// ═══ ATTACHMENTS (DUAL-LEVEL) ═══

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  commentId    String?  @map("comment_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type") @db.VarChar(100)
  storageKey   String   @map("storage_key") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment    Comment?        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy WorkspaceMember @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([commentId])
  @@map("attachments")
}

// ═══ RECURRENCE ═══

enum RecurrenceFrequency {
daily
weekly
monthly
yearly
custom
}

enum RecurrenceEndTyoe {
never
after_count
on_date
}

model RecurrenceRule {
  id                    String              @id @default(uuid()) @db.Uuid
  taskId                String              @unique @map("task_id") @db.Uuid
  workspaceId           String              @map("workspace_id") @db.Uuid
  frequency             RecurrenceFrequency
  interval              Int                 @default(1)
  daysOfWeek            Int[]               @map("days_of_week")
  dayOfMonth            Int?                @map("day_of_month")
  endType               RecurrenceEndType   @default(never) @map("end_type")
  endCount              Int?                @map("end_count")
  endDate               DateTime?           @map("end_date") @db.Date
  timezone              String              @default("UTC") @db.VarChar(50)
  repeatAfterCompletion Boolean             @default(false) @map("repeat_after_completion")
  repeatDelayValue      Int?                @map("repeat_delay_value")
  repeatDelayUnit       String?             @map("repeat_delay_unit") @db.VarChar(20)
  nextOccurrence        DateTime?           @map("next_occurrence")
  lastGenerated         DateTime?           @map("last_generated")
  isActive              Boolean             @default(true) @map("is_active")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instances TaskInstance[]

  @@index([workspaceId])
  @@index([isActive, nextOccurrence])
  @@map("recurrence_rules")
}

model TaskInstance {
  id               String   @id @default(uuid()) @db.Uuid
  recurrenceRuleId String   @map("recurrence_rule_id") @db.Uuid
  taskId           String   @unique @map("task_id") @db.Uuid
  occurrenceDate   DateTime @map("occurrence_date") @db.Date
  isDetached       Boolean  @default(false) @map("is_detached")
  createdAt        DateTime @default(now()) @map("created_at")

  recurrenceRule RecurrenceRule @relation(fields: [recurrenceRuleId], references: [id], onDelete: Cascade)
  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([recurrenceRuleId])
  @@map("task_instances")
}

// ═══ REMINDERS ═══

enum ReminderType { exact; relative; recurring }

model Reminder {
  id                  String       @id @default(uuid()) @db.Uuid
  taskId              String       @map("task_id") @db.Uuid
  workspaceMemberId   String       @map("workspace_member_id") @db.Uuid
  type                ReminderType
  exactTime           DateTime?    @map("exact_time")
  relativeOffsetValue Int?         @map("relative_offset_value")
  relativeOffsetUnit  String?      @map("relative_offset_unit") @db.VarChar(20)
  recurrenceRule      Json?        @map("recurrence_rule")
  snoozedUntil        DateTime?    @map("snoozed_until")
  isFired             Boolean      @default(false) @map("is_fired")
  isDismissed         Boolean      @default(false) @map("is_dismissed")
  nextFireTime        DateTime?    @map("next_fire_time")
  isSmartSuggestion   Boolean      @default(false) @map("is_smart_suggestion")
  suggestedReason     String?      @map("suggested_reason") @db.VarChar(500)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  task            Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  @@index([taskId])
  @@index([workspaceMemberId])
  @@map("reminders")
}

// ═══ NOTIFICATIONS ═══

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  type        String    @db.VarChar(100)
  title       String    @db.VarChar(255)
  body        String    @db.Text
  data        Json      @default("{}")
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient WorkspaceMember @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@index([recipientId, createdAt])
  @@map("notifications")
}

// ═══ TEMPLATES ═══

enum TemplateType { task; list }
enum TemplateVisibility { personal; workspace }

model Template {
  id             String             @id @default(uuid()) @db.Uuid
  workspaceId    String             @map("workspace_id") @db.Uuid
  type           TemplateType
  name           String             @db.VarChar(255)
  description    String?            @db.Text
  createdById    String             @map("created_by_id") @db.Uuid
  visibility     TemplateVisibility @default(personal)
  data           Json
  version        Int                @default(1)
  versionHistory Json               @default("[]") @map("version_history")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember @relation(fields: [createdById], references: [id])
  @@index([workspaceId])
  @@map("templates")
}

// ═══ SAVED VIEWS ═══

enum ViewType {
 list
 board
 calendar
 }
enum ViewVisibility {
 personal
 shared
 }

model SavedView {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  createdById String         @map("created_by_id") @db.Uuid
  name        String         @db.VarChar(255)
  type        ViewType
  filters     Json           @default("{}")
  sort        Json           @default("{}")
  groupBy     String?        @map("group_by") @db.VarChar(50)
  visibility  ViewVisibility @default(personal)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember @relation(fields: [createdById], references: [id])
  @@index([workspaceId])
  @@map("saved_views")
}

// ═══ AUDIT LOG ═══

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  workspaceId String   @map("workspace_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.VarChar(50)
  changes     Json     @default("{}")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     WorkspaceMember?  @relation("AuditActor", fields: [actorId], references: [id])
  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
